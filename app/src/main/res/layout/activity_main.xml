<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/botToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Bot Token (paste here)"
        android:inputType="textNoSuggestions|textVisiblePassword"/>

    <EditText
        android:id="@+id/chatId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Chat ID (e.g., -1001234567890 or your numeric id)"
        android:inputType="text"/>

    <Button
        android:id="@+id/testConnectionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Connection (Send Hello)"
        android:backgroundTint="#FF9800"/>

    <Button
        android:id="@+id/testAudioButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Audio (Record 5s &amp; Send)"
        android:backgroundTint="#009688"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Sending"/>

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Sending"/>
    <Button
        android:id="@+id/screenshotButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Screenshot Capture" />

    <Switch
        android:id="@+id/cameraSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Include Camera Photo (Front/Back) "
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/downloadLogsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Force Upload Logs"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/shareLocalLogsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share Logs via App"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/screenshotIntervalEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Screenshot Interval (seconds, min 5)"
        android:inputType="number"
        android:text="10" 
        android:layout_marginTop="8dp" />

    <Switch
        android:id="@+id/audioSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable Audio Recording"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/audioDurationEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Audio Chunk Duration (seconds)"
        android:inputType="number"
        android:text="60"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <Switch
        android:id="@+id/screenOffOnlySwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Only When Screen is OFF"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Idle"
        android:paddingTop="12dp"/>
</LinearLayout>
