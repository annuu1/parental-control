<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/botToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Bot Token (paste here)"
        android:inputType="textNoSuggestions|textVisiblePassword"/>

    <EditText
        android:id="@+id/chatId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Chat ID (e.g., -1001234567890 or your numeric id)"
        android:inputType="text"/>

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Sending"/>

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Sending"/>
    <Button
        android:id="@+id/screenshotButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Screenshot Capture" />

    <Switch
        android:id="@+id/cameraSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Include Camera Photo (Front/Back) "
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/downloadLogsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View/Share Logs"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/cameraIntervalEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Camera Interval (seconds, e.g., 300)"
        android:inputType="number"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Idle"
        android:paddingTop="12dp"/>
</LinearLayout>

